@model CRM.Models.Company

@{
    ViewData["Title"] = "Detalhes da Empresa";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Detalhes da Empresa: @Model.Nome</h2>

        <div class="card card-body shadow-sm mb-4">
            <dl class="row mb-0">
                <dt class="col-sm-3">Nome:</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Website:</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank">@Model.Website</a>
                    }
                    else
                    {
                        <span class="text-muted">Não especificado</span>
                    }
                </dd>

                <dt class="col-sm-3">País:</dt>
                <dd class="col-sm-9">@Model.Pais</dd>

                <dt class="col-sm-3">Cidade:</dt>
                <dd class="col-sm-9">@Model.Cidade</dd>

                <dt class="col-sm-3">Tecnologias:</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Tec))
                    {
                        <span class="badge bg-secondary">@Model.Tec</span>
                    }
                    else
                    {
                        <span class="text-muted">Não especificadas</span>
                    }
                </dd>
            </dl>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar Empresa</a>
            <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
        </div>
    </div>
</div>