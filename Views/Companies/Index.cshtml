@model IEnumerable<CRM.Models.Company>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    ViewData["Title"] = "Lista de Empresas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Empresas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Empresa</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Website</th>
            <th>Pais</th>
            <th>Cidade</th>
            <th>Tecnologia</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nome</td>
            <td>@item.Pais</td>
            <td>@item.Website</td>
            <td>@item.Cidade</td>
            <td>@item.Tec</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Apagar</a>
            </td>
        </tr>
    }
    </tbody>
</table>