@model IEnumerable<CRM.Models.JobApplication>

@{
    ViewData["Title"] = "Tabela de candidaturas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Candidaturas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Candidatura</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Titulo</th>
            <th>Empresa</th>
            <th>Estado</th>
            <th>Salario</th>
            <th>Tipo</th>
            <th>DataCriacao</th>
            <th>DataAtualizacao</th>
            <th>DataExpiracao</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Titulo</td>
            <td>@item.Company?.Nome</td>
            <td>@item.Estado</td>
            <td>@item.Salario</td>
            <td>@item.Tipo</td>
            <td>@item.DataCriacao</td>
            <td>@item.DataAtualizacao</td>
            <td>@item.DataExpiracao</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Apagar</a>
            </td>
        </tr>
    }
    </tbody>
</table>