@model CRM.Models.Company

@{
    ViewData["Title"] = "Nova Empresa";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Criar Nova Empresa</h2>
        
        <form asp-action="Create" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: Microsoft" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Website" class="form-label"></label>
                <input asp-for="Website" class="form-control" placeholder="https://..." />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Pais" class="form-label"></label>
                    <input asp-for="Pais" class="form-control" placeholder="Ex: Portugal" />
                    <span asp-validation-for="Pais" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Cidade" class="form-label"></label>
                    <input asp-for="Cidade" class="form-control" placeholder="Ex: Lisboa" />
                    <span asp-validation-for="Cidade" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Tec" class="form-label">Tecnologias</label>
                <input asp-for="Tec" class="form-control" placeholder="Ex: C#, .NET, SQL" />
                <span asp-validation-for="Tec" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Criar Empresa</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}