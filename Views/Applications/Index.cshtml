@model IEnumerable<CRM.Models.JobApplication>

@{
    ViewData["Title"] = "Tabela de candidaturas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Candidaturas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Candidatura</a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-4 shadow-sm">
    <div class="row g-3">
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Pesquisar por nome..." />
        </div>

        <div class="col-md-3">
            <select name="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                <option value="">Todas as empresas</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="estado" class="form-select" asp-items="Html.GetEnumSelectList<CRM.Models.ApplicationStatus>()">
                <option value="">Todos os estados</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Titulo</th>
            <th>Empresa</th>
            <th>Estado</th>
            <th>Salario</th>
            <th>Tipo</th>
            <th>DataCriacao</th>
            <th>DataAtualizacao</th>
            <th>DataExpiracao</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
{
    var corDoBadge = item.Estado switch
    {
        ApplicationStatus.Submetido => "bg-primary",
        ApplicationStatus.EntrevistadeApresentacao => "bg-info text-dark",
        ApplicationStatus.TesteTecnico => "bg-warning text-dark",
        ApplicationStatus.OfertaAberta => "bg-success",
        ApplicationStatus.Rejeitado => "bg-danger",
        _ => "bg-secondary"
    };

    <tr>
        <td>@item.Titulo</td>
        <td>@item.Company?.Nome</td>
        <td>
            <span class="badge @corDoBadge">@item.Estado</span>
        </td>
        <td>@item.Salario</td>
        <td>@item.Tipo</td>
        <td>@item.DataCriacao</td>
        <td>@item.DataAtualizacao</td>
        <td>@item.DataExpiracao</td>
        <td>
            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalhes</a>
            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Apagar</a>
        </td>
    </tr>
}
    </tbody>
</table>